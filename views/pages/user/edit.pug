extends ../../layouts/default.pug
include ../../mixins/box-head.pug
include ../../mixins/alert.pug

block main
    +alert-success(5000)

    .container.my-3
        +box-head(pageTitle)

        form(
            action=`/edit?_method=PATCH`
            method="POST"
        )
            div(class="form-group")
                label(for="fullName") Họ tên *
                input(
                    type="text"
                    class="form-control"
                    id="fullName"
                    name="fullName"
                    value=user.fullName
                    require
                )

            div(class="form-group")
                label(for="email") Email *
                input(
                    type="email"
                    class="form-control"
                    id="email"
                    name="email"
                    value=user.email
                    require
                )

            div(class="form-group")
                label(for="phone") Số điện thoại
                input(
                    type="number"
                    class="form-control"
                    id="phone"
                    name="phone"
                    value=user.phone
                    require
                )

            div(class="form-group")
                button(
                    type="submit"
                    class="btn btn-primary"
                ) Thay đổi