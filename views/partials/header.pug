header.header
    .container 
        .row.align-items-center
            .col-2
                .inner-logo 
                    a(href="/")
                        img(src="/images/logo.jpg", alt="Logo")

            .col-7
                .inner-menu 
                    ul  
                        if (user)
                            li 
                                a(href="/chat") Chat
                            li 
                                a(href="/info") #{user.fullName}
                                a(href="/logout") Đăng xuất
                        else 
                            li 
                                a(href="/") Đăng nhập
                            li 
                                a(href="/register") Đăng ký
                        